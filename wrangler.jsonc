{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyberuser-lagezentrum",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  // No public *.workers.dev address and no preview URLs: only the route below
  "workers_dev": false,
  "preview_urls": false,
  // Matches /news, /news/ and anything else starting with /news;
  // the Worker answers 404 for every path it does not explicitly serve
  "routes": [
    { "pattern": "cyberuser.de/news*", "zone_name": "cyberuser.de" }
  ],
  // Every 6 hours (UTC): 00:00, 06:00, 12:00, 18:00
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "kv_namespaces": [
    { "binding": "LAGE", "id": "596cea4a4faf402697ff8ca670f44336" }
  ],
  // Keep explicit console logs from the cron run; drop automatic per-request
  // invocation logs so no visitor metadata (IP, headers) is stored
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
