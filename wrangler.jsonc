{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyberuser-lagezentrum",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  // No public *.workers.dev address and no preview URLs: only the route below
  "workers_dev": false,
  "preview_urls": false,
  // Former Lagezentrum page: /news and /news/ redirect to the homepage;
  // the Worker answers 404 for everything else starting with /news
  "routes": [
    { "pattern": "cyberuser.de/news*", "zone_name": "cyberuser.de" },
    // Exact homepage only: no wildcard, so /index.html and URLs with a
    // query string go straight to the origin, without the brief
    { "pattern": "cyberuser.de/", "zone_name": "cyberuser.de" }
  ],
  // Every hour at minute 17 (UTC). NVD is fetched every two hours, see
  // SOURCE_INTERVAL_MS in src/worker.js
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "kv_namespaces": [
    { "binding": "LAGE", "id": "596cea4a4faf402697ff8ca670f44336" }
  ],
  // Keep explicit console logs from the cron run; drop automatic per-request
  // invocation logs so no visitor metadata (IP, headers) is stored
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
